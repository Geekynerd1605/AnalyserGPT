import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load the iris dataset
data = pd.read_csv('iris.csv')

# Display the first few rows of the data to the console
print(data.head())

# Use seaborn to create a pairplot which is quite common for the Iris dataset
# It will show scatter plots for each pair of features, colored by species (properly using 'variety' now)
sns.pairplot(data, hue='variety', diag_kind='kde', markers=["o", "s", "D"])

# Show the plot
plt.show()

print("Plot created successfully and displayed using 'variety' as hue")

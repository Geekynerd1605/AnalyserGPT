import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load the iris dataset
data = pd.read_csv('iris.csv')

# Check the first few rows of the data to understand what to plot
print(data.head())

# Use seaborn to create a pairplot which is quite common for the Iris dataset
# It will show scatter plots for each pair of features, colored by species
sns.pairplot(data, hue='species', diag_kind='kde', markers=["o", "s", "D"])

# Show the plot
plt.show()

print("Plot created successfully!")

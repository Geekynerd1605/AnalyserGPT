import pandas as pd
import matplotlib.pyplot as plt
import matplotlib

# Use 'Agg' backend for matplotlib to save plots as files
matplotlib.use("Agg")

# Load the iris.csv data
data = pd.read_csv('iris.csv')

# Plotting the count of each flower species
species_count = data['species'].value_counts()

# Create a bar plot
plt.figure(figsize=(8, 6))
species_count.plot(kind='bar')
plt.title('Count of Iris Flower Species')
plt.xlabel('Species')
plt.ylabel('Count')

# Save the plot to a file
plt.savefig("iris_species_count.png", bbox_inches="tight")

print("Plot saved as 'iris_species_count.png'.")
